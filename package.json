{
  "name": "cliicker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/api/server.ts",
    "db:init": "tsx apps/api/init.ts",
    "test": "tsx --test tests/engine.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "simulate": "tsx tests/simulate.ts",
    "dev:local": "npm run build && node --import tsx apps/api/local.ts",
    "dev:demo": "npm run build && node --import tsx apps/api/local.ts --demo"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "mongodb": "7.8.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "exit-hook": "5.1.0",
    "mongodb-memory-server": "11.3.0",
    "node": "22.23.5",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  }
}
