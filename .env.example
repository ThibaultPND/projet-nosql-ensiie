# Defaults in compose.yaml allow a fresh local clone to start without this file.
WEB_BIND=127.0.0.1
WEB_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Replace with distinct random URL-safe secrets on a server, BEFORE first start.
POSTGRES_PASSWORD=local_cliicker_only
MONGO_PASSWORD=local_mongo_only
